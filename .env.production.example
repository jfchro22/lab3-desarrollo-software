# Plantilla de variables de PRODUCCIÓN. NO contiene valores reales: se definen en el panel de la plataforma.
APP_ENV=production
APP_DEBUG=false
APP_KEY=                 # php artisan key:generate --show
APP_URL=https://su-servicio.onrender.com
DB_CONNECTION=pgsql
DB_URL=                  # cadena de conexión que entrega la plataforma
LOG_CHANNEL=stderr
LOG_LEVEL=warning
SESSION_DRIVER=array
CACHE_STORE=database
RUN_MIGRATIONS=true
SEED_ADMIN=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
